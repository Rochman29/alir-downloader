# Copy to .env.worker. Keep the real file private.
# Generate a random secret locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the SAME secret in the Vercel project's ALIR_WORKER_TOKEN variable.
ALIR_WORKER_TOKEN=

# For local Docker testing, these loopback defaults work.
# For live deployment, change both to your worker's public HTTPS domain / hostname.
ALIR_PUBLIC_WORKER_URL=http://127.0.0.1:8000
ALIR_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed only for the optional public HTTPS proxy (--profile public).
ALIR_WORKER_DOMAIN=localhost

# Default port is only reachable on the Docker host. Put an HTTPS reverse proxy in front.
ALIR_BIND_ADDRESS=127.0.0.1
ALIR_PORT=8000
ALIR_DOWNLOAD_LINK_TTL_SECONDS=3600
ALIR_MIN_FREE_GB=1
